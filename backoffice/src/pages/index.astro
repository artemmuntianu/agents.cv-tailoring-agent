---
import App from '../components/App.tsx';
import '../styles/global.css';

// The middleware guarantees a session on this route; `session` is name + email only.
const session = Astro.locals.session!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV tailoring backoffice</title>
    <meta name="description" content="Kanban board for tracking tailored vacancies" />
  </head>
  <body class="bg-slate-100 antialiased">
    <App client:load session={{ email: session.email, name: session.name ?? null }} />
  </body>
</html>
