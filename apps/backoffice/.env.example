---
# The board talks to the SAME Postgres the worker writes to. It is a server-side
# variable only - never exposed to the browser. Reach the cluster database with
# `kubectl port-forward svc/postgres 5432:5432` and run the board locally.
DATABASE_URL=postgresql://cvt:cvt@localhost:5432/cvt?sslmode=disable

# Session signing key for the backoffice. REQUIRED: there is no signup, an
# administrator provisions accounts with `node scripts/user.mjs add ...`, and the
# login endpoint refuses to issue tokens without this. Use a random 16+ character
# string (`node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`).
BACKOFFICE_JWT_SECRET=change-me-to-a-long-random-string

# The board itself queues tailoring (dragging a card into Prepare publishes to the
# cluster broker), so it needs a route to it: `kubectl port-forward svc/rabbitmq
# 5672:5672` in another terminal.
# Either a full URL, or the parts (the in-cluster Secret carries username/password).
RABBITMQ_URL=amqp://cvt:CHANGE_ME@localhost:5672/%2F
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=cvt
# RABBITMQ_PASSWORD=CHANGE_ME
# RABBITMQ_VHOST=/

# Must match the worker's configmap, or the gateway would publish into a queue
# nobody consumes.
QUEUE_NAME=resumes.generate
CV_VERSION=v1

# Where the worker's artifacts are *on this machine*. `resumes.pdf_url` holds the
# worker's own path (e.g. `/data/output/848944.pdf`), so the board serves downloads
# through `/api/artifacts/<job_id>` and resolves that path here:
#
#   ARTIFACTS_DIR   default: <repo>\artifacts   (cluster: /data, the cv-artifacts PVC)
#   OUTPUT_DIR      default: <ARTIFACTS_DIR>\output
#
# Two ways to point that at the cluster's documents - pick one:
#
# 1. Read the cluster volume directly (nothing is copied). Docker Desktop keeps its
#    PersistentVolumes on the VM disk, which Windows sees through WSL:
#
#      .\scripts\storage-files.ps1 -Action path      # prints the lines below, ready to paste
#
#    The path contains the PVC's own id, so re-run that action if the PVC is ever
#    recreated. `isWorkerVolumeRoot` recognises this root, so removing a vacancy deletes
#    the worker's real file instead of queueing it for `-Action purge`.
#    (Docker Desktop only - on another cluster use option 2 or deploy the board.)
#
# 2. Mirror the volume into the repo (a copy; re-run after each batch):
#
#      .\scripts\storage-files.ps1 -Action download    # -> artifacts\output
#
# ARTIFACTS_DIR=\\wsl$\docker-desktop\mnt\docker-desktop-disk\data\k8s-pvs\cv-artifacts\pvc-REPLACE-ME
# OUTPUT_DIR=\\wsl$\docker-desktop\mnt\docker-desktop-disk\data\k8s-pvs\cv-artifacts\pvc-REPLACE-ME\output

# Optional: where the server listens (default 4321).
# PORT=4321
