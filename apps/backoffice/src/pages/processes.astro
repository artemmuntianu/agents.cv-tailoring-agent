---
import ProcessesPage from '../components/ProcessesPage.tsx';
import '../styles/global.css';

// The middleware guarantees a session on this route; `session` is name + email only.
const session = Astro.locals.session!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Processes · CV tailoring backoffice</title>
    <meta
      name="description"
      content="Run history of the internal jobs: the RSS intake and the auto-archiver"
    />
  </head>
  <body class="bg-slate-100 antialiased">
    <ProcessesPage
      client:load
      session={{ email: session.email, name: session.name ?? null, admin: session.admin }}
    />
  </body>
</html>
