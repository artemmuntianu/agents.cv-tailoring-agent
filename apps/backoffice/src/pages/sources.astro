---
import SourcesPage from '../components/SourcesPage.tsx';
import '../styles/global.css';

// The middleware guarantees a session on this route; `session` is name + email only.
const session = Astro.locals.session!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sources · CV tailoring backoffice</title>
    <meta
      name="description"
      content="The data a generated CV or cover letter is built from: the master CV model, the master document, the candidate facts and the model rotation"
    />
  </head>
  <body class="bg-slate-100 antialiased">
    <SourcesPage
      client:load
      session={{ email: session.email, name: session.name ?? null, admin: session.admin }}
    />
  </body>
</html>
