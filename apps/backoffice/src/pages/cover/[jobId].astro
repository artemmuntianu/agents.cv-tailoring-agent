---
import CoverLetterPage from '../../components/CoverLetterPage.tsx';
import '../../styles/global.css';

// The middleware guarantees a session on this route; `session` is name + email only.
const session = Astro.locals.session!;
// `/cover/<job_id>` - the id is validated by the API the component calls, not here.
const jobId = Astro.params.jobId ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cover letter · CV tailoring backoffice</title>
    <meta
      name="description"
      content="One vacancy's cover letter - the text the application will send, and the button that asks for it"
    />
  </head>
  <body class="bg-slate-100 antialiased">
    <CoverLetterPage
      client:load
      jobId={jobId}
      session={{ email: session.email, name: session.name ?? null, admin: session.admin }}
    />
  </body>
</html>
