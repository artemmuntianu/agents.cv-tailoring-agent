# Never bake secrets or local state into the image.
.env
*.env
model_state.json

# Local artifacts / scratch data
artifacts/
scratch/
queue/
temp/
*.docx
*.pdf
*.png

# VCS / tooling
.git
.gitignore
.github
.venv
venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.idea/
.vscode/

# Deployment definitions are applied by helm/kubectl, not shipped in the image
charts/
deploy/
docs/

# Dev-only files
tests/
docker-compose.yml
README.md
