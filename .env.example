# Copy to `.env` for local runs. NEVER commit real values.
#
# This file feeds `scripts/worker-secret.ps1`, which turns GEMINI_API_KEY and
# DATABASE_URL into the worker Secret. Everything else has a default in `config.py`
# and is set for the cluster by `deploy/values/dev.yaml` -> the worker ConfigMap.

# --- LLM (the only external service) ---------------------------------------
GEMINI_API_KEY=replace-me
# MODEL_NAME=gemini-3.5-flash
# Comma-separated fallback ladder, most preferred first (validated at start-up).
# PREFERRED_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
MAX_REVISIONS=3
RENDER_DPI=70

# --- queue -----------------------------------------------------------------
# The cluster always runs amqp (set by the worker ConfigMap). The bare default in
# config.py is `directory`, which the tests use - a hand-run publisher.py would
# write JSON files instead of publishing, so use .\scripts\send-test-job.ps1, which
# sets QUEUE_BACKEND=amqp and rewrites RABBITMQ_URL to localhost.
# QUEUE_BACKEND=directory          # directory | amqp
# Either give the whole URL...
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
# ...or the parts (the URL is composed; in Kubernetes the credentials come from
# the broker Secret, so no password is stored here):
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=
# RABBITMQ_VHOST=/
# --- the scheduled intake (`python -m scout`) ------------------------------ #
# Comma-separated feed URLs and the account their cards are created as. There is no source knob:
# each feed's slug (`dou`, `djinni`, ...) comes from its host (`scout/sources.py`). The scout's
# two Telegram keys are optional: without them it creates the cards and stays silent.
# SCOUT_FEEDS=https://jobs.dou.ua/vacancies/feeds/?remote&category=.NET&exp=5plus
# SCOUT_USER_ID=
# SCOUT_MAX_PER_RUN=0
# A vacancy the feed itself dated older than this is not scraped (0 disables the rule).
# SCOUT_MAX_AGE_DAYS=7
# SCOUT_NOTIFY=telegram
# SCOUT_TELEGRAM_TOKEN=
# SCOUT_TELEGRAM_CHAT_ID=

# --- the scheduled housekeeping (`python -m archiver`) --------------------- #
# The inactivity sweep: cards in these columns that no operator action has touched for
# AUTO_ARCHIVE_AFTER_DAYS days are refused in place (the same in-place archive the card's
# button makes). It needs DB_BACKEND=postgres - the board's tables do not exist in the JSON
# backend, and the preflight refuses to run against it.
# AUTO_ARCHIVE_STAGES=applied
# AUTO_ARCHIVE_AFTER_DAYS=10
# AUTO_ARCHIVE_ACTOR=Company
# AUTO_ARCHIVE_REASON=No response
# AUTO_ARCHIVE_MAX_PER_RUN=50
# PROCESS_RUN_STALE_HOURS=24

# QUEUE_NAME=resumes.generate
# The on-demand cover-letter queue (`cover.py`); the DLX/DLQ names derive from it.
# COVER_QUEUE_NAME=resumes.cover
# PREFETCH_COUNT=1
# MAX_ATTEMPTS=3
# AMQP heartbeat; keep it ABOVE the longest task or the broker drops the connection
# mid-task and requeues the message ("missed heartbeats from client").
# AMQP_HEARTBEAT_SECONDS=600

# --- database --------------------------------------------------------------
# DB_BACKEND=local                 # local | postgres
# DATABASE_URL=postgresql://cvt:cvt@localhost:5432/cvt?sslmode=disable
# DATABASE_SSLMODE=require
# DB_PREPARE_STATEMENTS=false      # true only for direct/session connections
# MODEL_STATE_BACKEND=file         # file | postgres (shared between pods)

# --- paths (storage is local) ----------------------------------------------
# ARTIFACTS_DIR=./artifacts        # /data inside the cluster (a PVC)
# TEMP_ROOT=./artifacts/temp
# CV_DATA_PATH=./artifacts/cv_data.json
# OUTPUT_KEY_PREFIX=tailored

# --- runtime ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text                  # json for containers
# HEARTBEAT_MAX_AGE_SECONDS=300
# KEEP_TEMP_DIRS=false
# INTERACTIVE_QUOTA_WAIT=auto      # auto | true | false

# --- external binaries -----------------------------------------------------
# LIBREOFFICE_PATHS=/usr/bin/soffice:/usr/bin/libreoffice
# POPPLER_PATH=/usr/bin
