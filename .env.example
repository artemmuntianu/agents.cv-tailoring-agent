# ---------------------------------------------------------------------------
# Copy to `.env` for local runs. NEVER commit real values.
# Local defaults (no .env at all) keep working: directory queue, local storage,
# local JSON job store and the local model-state file.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
GEMINI_API_KEY=replace-me     # put the real value in .env (this file is committed)
# MODEL_NAME=gemini-3.5-flash
# Comma-separated fallback ladder (validated at worker start-up).
# PREFERRED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
MAX_REVISIONS=3
RENDER_DPI=70

# --- backend selection (local | cloud) -------------------------------------
# QUEUE_BACKEND=directory            # directory | amqp
# STORAGE_BACKEND=local              # local | supabase
# DB_BACKEND=local                   # local | postgres
# MODEL_STATE_BACKEND=file           # file | postgres

# --- RabbitMQ (QUEUE_BACKEND=amqp) -----------------------------------------
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
# RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# QUEUE_NAME=resumes.generate
# PREFETCH_COUNT=1
# MAX_ATTEMPTS=3
# QUEUE_RETRY_TTL_MS=300000

# --- Supabase / Postgres ---------------------------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSLMODE=require
# Pooled Supabase connections (port 6543) cannot use prepared statements:
# DB_PREPARE_STATEMENTS=false
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-me
# SUPABASE_BUCKET=resumes
# SUPABASE_MASTER_CV_KEY=master/cv.docx
# SUPABASE_CV_DATA_KEY=master/cv_data.json
# SUPABASE_OUTPUT_PREFIX=tailored

# --- runtime ---------------------------------------------------------------
# LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text                    # text (dev) | json (containers)
# TEMP_ROOT=./artifacts/temp
# ARTSFACTS_DIR, INPUT_DIR, OUTPUT_DIR, TEMP_DIR, QUEUE_DIR, CV_DATA_PATH
# HEARTBEAT_MAX_AGE_SECONDS=300
# KEEP_TEMP_DIRS=false
# INTERACTIVE_QUOTA_WAIT=auto        # auto | true | false

# --- external binaries -----------------------------------------------------
# LIBREOFFICE_PATHS=/usr/bin/soffice:/usr/bin/libreoffice
# POPPLER_PATH=/usr/bin
